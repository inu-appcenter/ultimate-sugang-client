# 03 §8 env 구조 — 실제 값은 .env 에 사람이 입력한다(.env 는 커밋 금지, 하네스가 생성하지 않음)
# 어댑터: mock(기본) | http(서버 연동, D55)
VITE_API_ADAPTER=mock
# http 어댑터 선택 시에만 필수. **서버 기본 경로 `/api/v1` 까지 포함**해서 적는다(D55)
#   예) VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_API_BASE_URL=
# session → SESSION_EXPIRED 강제 발생(mock 수동 검증용). 미설정이면 정상 동작
VITE_MOCK_FAIL=
# on → 신청 시 CAPTCHA 모달 발동(원§9.1). 기본 off (D34)
VITE_CAPTCHA=
